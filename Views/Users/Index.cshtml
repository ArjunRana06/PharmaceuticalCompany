@model IEnumerable<Project.Models.User>

@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var users = Model?.ToList() ?? new List<Project.Models.User>();
}

@if (TempData["Success"] is string success)
{
    <div class="ph-alert is-success ph-reveal">
        <i class="bi bi-check2-circle"></i>
        <div>@success</div>
    </div>
}

@if (TempData["Error"] is string error)
{
    <div class="ph-alert is-warning ph-reveal">
        <i class="bi bi-exclamation-triangle"></i>
        <div>@error</div>
    </div>
}

<div class="ph-page-head">
    <div>
        <h2>Console users</h2>
        <p>Manage accounts that can access the pharmaceutical management console.</p>
    </div>
    <button type="button" class="ph-btn ph-btn-primary ph-btn-sm" data-modal-open="addUserModal">
        <i class="bi bi-person-plus"></i> Add user
    </button>
</div>

<div class="ph-table-wrap ph-reveal">

    <div class="ph-table-head">
        <div>
            <h3>Registered accounts</h3>
            <p>@users.Count user(s) with console access</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="position-relative">
                <input class="ph-input" style="padding-left:2.4rem;min-width:240px;"
                       type="search" placeholder="Search users..." data-table-search="usersTable" />
                <i class="bi bi-search position-absolute" style="left:.9rem;top:50%;transform:translateY(-50%);color:var(--ph-muted);"></i>
            </div>
            <span class="ph-badge">@users.Count total</span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="ph-table" id="usersTable">
            <thead>
                <tr>
                    <th style="width:70px;">ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Access</th>
                    <th style="width:240px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (users.Any())
                {
                    foreach (var user in users)
                    {
                        <tr>
                            <td><strong>#@user.Id</strong></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="ph-avatar is-soft" style="width:34px;height:34px;">
                                        @(string.IsNullOrWhiteSpace(user.Name) ? "?" : user.Name.Trim()[..1].ToUpperInvariant())
                                    </span>
                                    <strong>@user.Name</strong>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td><span class="ph-badge is-success">Active</span></td>
                            <td>
                                <div class="ph-actions">
                                    <button type="button" class="ph-btn ph-btn-outline ph-btn-sm"
                                            data-id="@user.Id" data-name="@user.Name" data-email="@user.Email"
                                            onclick="openEditUser(this)">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>

                                    @if (user.Role != "Admin")
                                    {
                                        <form asp-controller="Users" asp-action="Delete" asp-route-id="@user.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="ph-btn ph-btn-sm"
                                                    style="background:#fff1f2;color:#be123c;border:1px solid #fecdd3;"
                                                    onclick="return confirm('Delete @user.Name? This cannot be undone.');">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="ph-badge is-muted">Protected</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="ph-empty">
                                <i class="bi bi-people"></i>
                                <h4>No users found</h4>
                                <p>Create the first console account to get started.</p>
                                <button type="button" class="ph-btn ph-btn-primary ph-btn-sm mt-2" data-modal-open="addUserModal">
                                    <i class="bi bi-person-plus"></i> Add user
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="ph-modal" id="addUserModal" role="dialog" aria-modal="true" aria-labelledby="addUserTitle">
    <div class="ph-modal-panel">
        <div class="ph-modal-head">
            <h3 id="addUserTitle"><i class="bi bi-person-plus me-2" style="color:var(--ph-teal-600);"></i>Add console user</h3>
            <button type="button" class="ph-modal-close" data-modal-close aria-label="Close">&times;</button>
        </div>

        <form asp-controller="Users" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="ph-modal-body">
                <div class="ph-field">
                    <label class="ph-label" for="addName">Full name <span class="ph-req">*</span></label>
                    <input class="ph-input" type="text" id="addName" name="Name" placeholder="e.g. Aisha Gurung" required />
                </div>

                <div class="ph-field">
                    <label class="ph-label" for="addEmail">Email address <span class="ph-req">*</span></label>
                    <input class="ph-input" type="email" id="addEmail" name="Email" placeholder="name@company.com" required />
                </div>

                <div class="ph-field" style="margin-bottom:0;">
                    <label class="ph-label" for="addPassword">Password <span class="ph-req">*</span></label>
                    <input class="ph-input" type="password" id="addPassword" name="Password" placeholder="Create a strong password" required />
                    <p class="ph-hint">Minimum 8 characters, mixed letters and numbers.</p>
                </div>
            </div>

            <div class="ph-modal-foot">
                <button type="button" class="ph-btn ph-btn-ghost ph-btn-sm" data-modal-close>Cancel</button>
                <button type="submit" class="ph-btn ph-btn-primary ph-btn-sm">
                    <i class="bi bi-check2"></i> Create user
                </button>
            </div>
        </form>
    </div>
</div>

<div class="ph-modal" id="editUserModal" role="dialog" aria-modal="true" aria-labelledby="editUserTitle">
    <div class="ph-modal-panel">
        <div class="ph-modal-head">
            <h3 id="editUserTitle"><i class="bi bi-pencil-square me-2" style="color:var(--ph-teal-600);"></i>Edit console user</h3>
            <button type="button" class="ph-modal-close" data-modal-close aria-label="Close">&times;</button>
        </div>

        <form asp-controller="Users" asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <div class="ph-modal-body">
                <input type="hidden" id="editId" name="Id" />

                <div class="ph-field">
                    <label class="ph-label" for="editName">Full name <span class="ph-req">*</span></label>
                    <input class="ph-input" type="text" id="editName" name="Name" required />
                </div>

                <div class="ph-field">
                    <label class="ph-label" for="editEmail">Email address <span class="ph-req">*</span></label>
                    <input class="ph-input" type="email" id="editEmail" name="Email" required />
                </div>

                <div class="ph-field" style="margin-bottom:0;">
                    <label class="ph-label" for="editPassword">New password</label>
                    <input class="ph-input" type="password" id="editPassword" name="Password" placeholder="Leave blank to keep current password" />
                </div>
            </div>

            <div class="ph-modal-foot">
                <button type="button" class="ph-btn ph-btn-ghost ph-btn-sm" data-modal-close>Cancel</button>
                <button type="submit" class="ph-btn ph-btn-primary ph-btn-sm">
                    <i class="bi bi-check2"></i> Save changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openEditUser(trigger) {
            document.getElementById("editId").value = trigger.getAttribute("data-id");
            document.getElementById("editName").value = trigger.getAttribute("data-name");
            document.getElementById("editEmail").value = trigger.getAttribute("data-email");
            document.getElementById("editPassword").value = "";

            var modal = document.getElementById("editUserModal");
            modal.classList.add("is-open");
            document.body.style.overflow = "hidden";
        }
    </script>
}
