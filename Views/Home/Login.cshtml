@{
    ViewData["Title"] = "Sign in";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="ph-auth">

    <!-- ==================== BRAND SIDE ==================== -->
    <aside class="ph-auth-aside">

        <a class="ph-brand" asp-controller="Home" asp-action="Index" style="color:#fff;">
            <span class="ph-brand-mark">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 2.6c3.3 0 6 2.4 6 5.3v8.2c0 2.9-2.7 5.3-6 5.3s-6-2.4-6-5.3V7.9c0-2.9 2.7-5.3 6-5.3Z" fill="#ffffff" fill-opacity=".95"/>
                    <path d="M6.05 11.6h11.9v4.5c0 2.9-2.66 5.3-5.95 5.3s-5.95-2.4-5.95-5.3v-4.5Z" fill="#5eead4"/>
                </svg>
            </span>
            <span class="ph-brand-text">
                PharmaCore
                <small>Pharma Management Suite</small>
            </span>
        </a>

        <div>
            <span class="ph-eyebrow is-dark">Secure console</span>
            <h2>Regulatory clarity for every medicine you make.</h2>
            <p>
                Sign in to manage pharmaceutical companies, drug registrations, batch recalls
                and DDA notices &mdash; all in one audit-ready workspace.
            </p>

            <ul class="ph-auth-points">
                <li>
                    <i class="bi bi-check2"></i>
                    <span>Track batch-level recalls with severity ranking</span>
                </li>
                <li>
                    <i class="bi bi-check2"></i>
                    <span>Maintain a verified manufacturer directory</span>
                </li>
                <li>
                    <i class="bi bi-check2"></i>
                    <span>Publish regulatory notices with full source attribution</span>
                </li>
                <li>
                    <i class="bi bi-check2"></i>
                    <span>Role-based access with secure cookie sessions</span>
                </li>
            </ul>
        </div>

        <div style="display:flex;align-items:center;gap:1rem;font-size:.8rem;color:#8fadb9;">
            <span><i class="bi bi-shield-lock-fill"></i> 256-bit encrypted sessions</span>
            <span><i class="bi bi-clock-history"></i> 24/7 availability</span>
        </div>

    </aside>

    <!-- ==================== FORM SIDE ==================== -->
    <div class="ph-auth-main">
        <div class="ph-auth-card">

            <div class="d-flex align-items-center gap-2 mb-4">
                <span class="ph-stat-icon"><i class="bi bi-person-lock"></i></span>
                <span class="ph-eyebrow" style="margin:0;">Member access</span>
            </div>

            <h1>Welcome back</h1>
            <p>Enter your credentials to access the PharmaCore console.</p>

            @if (ViewBag.Error != null)
            {
                <div class="ph-alert is-danger">
                    <i class="bi bi-exclamation-octagon-fill"></i>
                    <div>
                        <strong>Sign-in failed</strong>
                        @ViewBag.Error
                    </div>
                </div>
            }

            <form method="post" asp-action="LoginUser">

                <div class="ph-field">
                    <label class="ph-label" for="email">
                        Email address <span class="ph-req">*</span>
                    </label>
                    <div class="position-relative">
                        <input class="ph-input" id="email" name="Email" type="email"
                               autocomplete="email" placeholder="you@company.com" required />
                    </div>
                </div>

                <div class="ph-field">
                    <label class="ph-label" for="password">
                        Password <span class="ph-req">*</span>
                    </label>
                    <div class="position-relative">
                        <input class="ph-input" id="password" name="Password" type="password"
                               autocomplete="current-password" placeholder="Enter your password" required />
                        <button type="button" class="ph-icon-btn position-absolute"
                                style="top:4px;right:4px;width:38px;height:38px;border:0;background:transparent;"
                                data-toggle-password="password" aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                    <label class="ph-checkbox mb-0">
                        <input type="checkbox" name="remember" />
                        Keep me signed in
                    </label>
                    <a href="#" style="font-size:.85rem;font-weight:600;">Forgot password?</a>
                </div>

                <button class="ph-btn ph-btn-primary ph-btn-block ph-btn-lg" type="submit" style="margin-top:1.15rem;">
                    <i class="bi bi-box-arrow-in-right"></i> Sign in securely
                </button>
            </form>

            <div class="ph-auth-foot">
                Need an account? <a href="#">Request access from your administrator</a>
            </div>

            <div class="text-center mt-3">
                <a class="ph-btn ph-btn-ghost ph-btn-sm" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-arrow-left"></i> Back to home
                </a>
            </div>

        </div>
    </div>

</div>
